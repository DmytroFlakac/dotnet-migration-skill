{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dotnet-migration-skill/baseline.schema.json",
  "title": "dotnet-migration-skill baseline",
  "type": "object",
  "required": [
    "schema_version",
    "commands",
    "restore_succeeded",
    "build_succeeded",
    "projects_built",
    "projects_skipped",
    "tests",
    "warnings",
    "errors",
    "environmental_blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code",
          "duration_s",
          "log"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_s": {
            "type": "number"
          },
          "log": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "restore_succeeded": {
      "type": "boolean"
    },
    "build_succeeded": {
      "type": "boolean"
    },
    "projects_built": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "output"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "projects_skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "reason"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "executed",
        "total",
        "passed",
        "failed",
        "skipped",
        "results"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "project",
              "test",
              "outcome"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "test": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "unknown",
                  "timeout",
                  "aborted",
                  "inconclusive"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message",
          "file",
          "line",
          "project",
          "failure_class"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_class": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message",
          "file",
          "line",
          "project",
          "failure_class"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_class": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "environmental_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
