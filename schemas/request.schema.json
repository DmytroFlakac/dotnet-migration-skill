{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dotnet-migration-skill/request.schema.json",
  "title": "dotnet-migration-skill request",
  "type": "object",
  "required": [],
  "properties": {
    "repository": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "analysis",
        "implementation",
        "global",
        "validate",
        "validation",
        "rollback"
      ]
    },
    "targetFramework": {
      "const": "net10.0"
    },
    "group": {
      "type": [
        "string",
        "null"
      ]
    },
    "maxRepairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "outputDir": {
      "type": "string"
    },
    "allowPublicNuget": {
      "type": "boolean"
    },
    "repository_path": {
      "type": "string"
    },
    "target_framework": {
      "const": "net10.0"
    },
    "allow_public_nuget": {
      "type": "boolean"
    },
    "selected_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allow_reversible_experiments": {
      "type": "boolean"
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "output_directory": {
      "type": "string"
    },
    "network_policy": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "GROUP_MIGRATION",
        "MULTITARGET_SHARED"
      ]
    },
    "shared_library_policy": {
      "const": "MULTITARGET_UNTIL_LAST_CONSUMER"
    },
    "allow_repository_global_changes": {
      "type": "boolean"
    },
    "global_plan_id": {
      "type": "string"
    },
    "allow_network": {
      "type": "boolean"
    },
    "package_catalog": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapters": {
      "type": "array",
      "items": {
        "enum": [
          "aspnet_core",
          "efcore",
          "windows_service"
        ]
      }
    },
    "scope": {
      "enum": [
        "group",
        "repository"
      ]
    },
    "time_budget_minutes": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "repository",
        "mode"
      ]
    },
    {
      "required": [
        "repository_path",
        "mode"
      ]
    }
  ]
}
