{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dotnet-migration-skill/preflight.schema.json",
  "title": "dotnet-migration-skill preflight",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "sdks",
    "runtimes",
    "platforms",
    "package_sources",
    "resources",
    "disposable_workspace",
    "external_test_services",
    "licensed_tools",
    "capabilities",
    "limitations",
    "blocking_items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "READY",
        "READY_WITH_LIMITATIONS",
        "BLOCKED"
      ]
    },
    "sdks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "root"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "root"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "os"
        ],
        "properties": {
          "os": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "package_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu_cores",
        "memory_mb",
        "disk_free_mb",
        "network_egress_policy"
      ],
      "properties": {
        "cpu_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "disk_free_mb": {
          "type": "integer"
        },
        "network_egress_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "disposable_workspace": {
      "type": "object",
      "required": [
        "git_available",
        "worktree_supported",
        "preferred_method"
      ],
      "properties": {
        "git_available": {
          "type": "boolean"
        },
        "worktree_supported": {
          "type": "boolean"
        },
        "preferred_method": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "external_test_services": {
      "type": "array",
      "items": {}
    },
    "licensed_tools": {
      "type": "array",
      "items": {}
    },
    "capabilities": {
      "type": "object",
      "required": [
        "can_evaluate_msbuild",
        "can_build",
        "can_test_net8",
        "can_test_net10",
        "can_build_windows_projects",
        "can_experiment"
      ],
      "properties": {
        "can_evaluate_msbuild": {
          "type": "boolean"
        },
        "can_build": {
          "type": "boolean"
        },
        "can_test_net8": {
          "type": "boolean"
        },
        "can_test_net10": {
          "type": "boolean"
        },
        "can_build_windows_projects": {
          "type": "boolean"
        },
        "can_experiment": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "detail",
          "affects"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "affects": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "blocking_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
